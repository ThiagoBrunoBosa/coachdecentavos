# Copie para .env.vercel, preencha os valores e importe na Vercel (Production).
# NUNCA commite .env.vercel — contém secrets.

# API Render (staging)
NEXT_PUBLIC_API_URL=https://coachdecentavos-api.onrender.com/api/v1
API_INTERNAL_URL=https://coachdecentavos-api.onrender.com/api/v1

# URL do site — use o domínio .vercel.app após o 1º deploy
NEXTAUTH_URL=https://coachdecentavos.vercel.app
AUTH_URL=https://coachdecentavos.vercel.app

# Gere com: openssl rand -base64 32  (mesmo valor nos dois)
NEXTAUTH_SECRET=SUBSTITUA_POR_SECRET_32_CHARS
AUTH_SECRET=SUBSTITUA_POR_SECRET_32_CHARS

# OAuth desligado por enquanto
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
