# Copy to .env for local tooling (never commit secrets).

# --- Development ---
ConnectionStrings__Default=Host=localhost;Port=5432;Database=coachdecentavos;Username=postgres;Password=postgres
Jwt__Issuer=coachdecentavos
Jwt__Audience=coachdecentavos-api
Jwt__SigningKey=dev_only_signing_key_at_least_32_characters_long
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7
Google__ClientId=your-google-oauth-client-id.apps.googleusercontent.com
Llm__ApiKey=
Llm__BaseUrl=https://api.groq.com/openai/v1
Llm__Model=llama-3.1-8b-instant
Llm__Enabled=true
Hotmart__HotTok=
Internal__CronSecret=local-dev-cron-secret
YouTube__ApiKey=
ADMIN_SEED_NAME=Admin
ADMIN_SEED_EMAIL=admin@local.dev
ADMIN_SEED_PASSWORD=ChangeMe123!
USER_SEED_NAME=Thiago Bosa
USER_SEED_EMAIL=thiago@local.dev
USER_SEED_PASSWORD=Thiago123456!
ASPNETCORE_ENVIRONMENT=Development
PORT=5299

